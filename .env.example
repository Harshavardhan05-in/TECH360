# ==============================================================================
# EventHorizon AI — Environment Configuration Template
# ==============================================================================

# Application Branding & Identity
APP_NAME="EventHorizon AI"
APP_ENV="development"
DEBUG=true
PORT=8000
FRONTEND_PORT=5173
ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration
# In local development without Postgres, an SQLite URL like 'sqlite+aiosqlite:///./eventhorizon.db' can be used.
# In staging/production, use PostgreSQL:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/eventhorizon"
DATABASE_URL_SYNC="postgresql+psycopg2://postgres:postgres@localhost:5432/eventhorizon"

# Redis & Background Workers
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Authentication & Security
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ANONYMOUS_EVENT_VIEW_LIMIT=5

# AI Provider Configuration (Interface-isolated: Gemini, OpenAI, Anthropic, or Local Ollama)
AI_PROVIDER="gemini"
AI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"

# Discovery Engine & Crawler Rules
CRAWLER_USER_AGENT="EventHorizonBot/1.0 (+https://eventhorizon.ai/bot; verification-crawler)"
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_CONTENT_BYTES=5242880
CRAWLER_DEFAULT_INTERVAL_HOURS=1
SSRF_PROTECTION_ENABLED=true

# External Search Integrations (Optional)
SEARCH_API_PROVIDER="duckduckgo"
SEARCH_API_KEY=""

# Admin Initial Seed Credentials (Used only on initial setup)
INITIAL_SUPERADMIN_EMAIL="admin@eventhorizon.ai"
INITIAL_SUPERADMIN_PASSWORD="ChangeMeInProduction123!"
